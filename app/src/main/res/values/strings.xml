    <!-- 10 Core UI States (Agent.MD Rules) -->
    <!-- 1. Empty State -->
    <string name="empty_state_title">Belum Ada Lokasi Dipilih</string>
    <string name="empty_state_desc">Silakan aktifkan GPS atau pilih salah satu kota di Indonesia untuk menghitung jadwal sholat dan arah kiblat secara presisi.</string>
    <string name="empty_state_cta">Pilih Kota Sekarang</string>

    <!-- 2. Loading State -->
    <string name="loading_state_title">Menghitung Jadwal Sholat...</string>
    <string name="loading_state_desc">Mengkalkulasi waktu astronomis dan sudut kiblat berdasarkan koordinat wilayah Anda.</string>

    <!-- 3. Error State -->
    <string name="error_state_title">Gagal Mendapatkan Lokasi</string>
    <string name="error_state_desc">Tidak dapat membaca koordinat perangkat. Pastikan sinyal GPS aktif atau gunakan pilihan kota manual.</string>
    <string name="error_state_retry">Coba Lagi</string>

    <!-- 4. Offline State -->
    <string name="offline_state_banner">Mode Offline Aktif — Perhitungan astronomis berjalan lokal di perangkat tanpa butuh kuota internet.</string>

    <!-- 5. Slow Network State -->
    <string name="slow_network_banner">Sinyal jaringan lemah. Menggunakan kalkulasi lokal agar jadwal sholat tetap akurat.</string>

    <!-- 6. Zero Search Results State -->
    <string name="zero_search_title">Kota Tidak Ditemukan</string>
    <string name="zero_search_desc">Tidak ada kota yang cocok dengan kata kunci tersebut. Coba gunakan nama kabupaten terdekat atau reset pencarian.</string>
    <string name="zero_search_reset">Reset Pencarian</string>
    <string name="zero_search_manual">Gunakan Lokasi GPS</string>

    <!-- 7. Permission Denied State -->
    <string name="permission_denied_title">Izin Akses Diperlukan</string>
    <string name="permission_denied_desc">Jalan Islam memerlukan izin Lokasi untuk mendeteksi koordinat jadwal sholat, serta izin Notifikasi dan Alarm Tepat Waktu agar suara adzan berkumandang tanpa terlambat.</string>
    <string name="permission_denied_cta">Buka Pengaturan Aplikasi</string>

    <!-- 8. Session Expiry & Draft Preservation -->
    <string name="draft_preserved_notice">Pengaturan dan koreksi menit Anda otomatis tersimpan aman di perangkat.</string>

    <!-- 9. Form Validation State -->
    <string name="validation_offset_error">Koreksi menit harus di antara -10 hingga +10 menit</string>

    <!-- 10. Success State -->
    <string name="success_saved_title">Berhasil Disimpan!</string>
    <string name="success_saved_desc">Pengaturan jadwal sholat dan alarm adzan telah diperbarui.</string>

